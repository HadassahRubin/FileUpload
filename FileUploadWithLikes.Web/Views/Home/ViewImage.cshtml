@model ImageViewModel

<div class="container">
    <main role="main" class="pb-3">
        <div class="row" data-id="@Model.Image.Id">
            <div class="col-md-8 offset-md-2">
                <div class="bg-light p-4 rounded shadow mb-3" style="text-align: center;">
                    <h3>@Model.Image.Title</h3>
                    <h5>Uploaded at: @Model.Image.DateTime.ToString("MM/dd/yyyy hh:mm tt")</h5>
                    <img style="width: 600px;" src="/images/@Model.Image.FileName" />

                    <div class="mt-3">
                        <button id="like-button" class="btn btn-primary"
                        @(Model.HasLiked ? "disabled" : "")>
                            Like
                        </button>
                        <span id="likes-count">@Model.Image.Likes</span>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>


@section Scripts {
    <script src="/js/ViewImage.js"></script>
}
