@model IndexViewModel

<div class="container">
    <main role="main" class="pb-3">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                @foreach (var image in Model.Images)
                {
                    <div class="bg-light p-4 rounded shadow mb-3" style="margin-bottom: 20px; text-align: center;">
                        <a href="/home/viewimage?id=@image.Id">
                            <h3>@image.Title</h3>
                            <h5>Uploaded at: @image.DateTime.ToString("MM/dd/yyyy hh:mm tt")</h5>
                            <img style="width: 400px;" src="/images/@image.FileName" />
                        </a>
                    </div>

                }
            </div>
        </div>
    </main>
</div>